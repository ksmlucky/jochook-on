# NEW Oracle installation only. Copy to .env.oracle on the VM, chmod 600.
# No protocol, path or port here. Cloudflare owns this hostname's HTTPS endpoint.
JOCHOOK_ON_SITE_ADDRESS=jochook-on.example.com
SESSION_COOKIE_SECURE=true
MYSQL_DATABASE=hana_fc
MYSQL_USER=hana_app
# Use separate random values; blank passwords prevent startup.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Empty database only: creates the initial administrator, never resets a password.
JOCHOOK_ON_BOOTSTRAP_USERNAME=admin
JOCHOOK_ON_BOOTSTRAP_PASSWORD=
JOCHOOK_ON_SERVICE_ADMIN_USERNAME=admin

# Explicit NEW volumes. When migrating an existing Docker host, preserve its actual names.
JOCHOOK_ON_MYSQL_VOLUME=jochook-on-oracle_mysql-data
JOCHOOK_ON_CADDY_DATA_VOLUME=jochook-on-oracle_caddy-data
JOCHOOK_ON_CADDY_CONFIG_VOLUME=jochook-on-oracle_caddy-config

# File contains ONLY the remotely managed tunnel token. Never put its value in this file.
# On Linux: owner 65532:65532, mode 0400; .local directory mode 0700.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.local/cloudflared-token

# Change all three together if this subnet overlaps another host/Docker network.
JOCHOOK_ON_TUNNEL_SUBNET=172.30.72.0/28
JOCHOOK_ON_TUNNEL_PROXY_IP=172.30.72.2
JOCHOOK_ON_TUNNEL_WEB_IP=172.30.72.3
