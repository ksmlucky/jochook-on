# Copy to .env.production on the deployment server. Never commit the real file.
# Replace the domain and set its DNS A/AAAA record to your server before starting.
HANA_SITE_ADDRESS=hana.example.com
HANA_BIND_ADDRESS=0.0.0.0
HANA_HTTP_PORT=80
HANA_HTTPS_PORT=443
SESSION_COOKIE_SECURE=true
MYSQL_DATABASE=hana_fc
MYSQL_USER=hana_app
# Set independent random passwords (e.g. openssl rand -hex 24). Empty values fail startup.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Creates an ADMIN only when the accounts table is empty. Not a password reset mechanism.
HANA_BOOTSTRAP_USERNAME=admin
HANA_BOOTSTRAP_PASSWORD=
