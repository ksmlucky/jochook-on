# Copy to .env.production on the deployment server. Never commit the real file.
# Replace the domain and set its DNS A/AAAA record to your server before starting.
JOCHOOK_ON_SITE_ADDRESS=jochook-on.example.com
JOCHOOK_ON_BIND_ADDRESS=0.0.0.0
JOCHOOK_ON_HTTP_PORT=80
JOCHOOK_ON_HTTPS_PORT=443
SESSION_COOKIE_SECURE=true
MYSQL_DATABASE=hana_fc
MYSQL_USER=hana_app
# Set independent random passwords (e.g. openssl rand -hex 24). Empty values fail startup.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Creates an ADMIN only when the accounts table is empty. Not a password reset mechanism.
JOCHOOK_ON_BOOTSTRAP_USERNAME=admin
JOCHOOK_ON_BOOTSTRAP_PASSWORD=
# Explicitly selects the account that can create teams; other ADMINs stay team admins.
JOCHOOK_ON_SERVICE_ADMIN_USERNAME=admin
