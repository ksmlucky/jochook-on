%% 조축ON · V34 배포 준비 · 2026.10.20
%% Solid lines: physical FK. Dotted REF lines: application-only logical references.
%% Important columns only; exact SQL types/checks are in Flyway V1..V34.
erDiagram
  teams {
    BIGINT id PK "BIGINT"
    VARCHAR name "VARCHAR"
    VARCHAR description "VARCHAR"
    VARCHAR status "PENDING / ACTIVE / INACTIVE"
    BIGINT version "수정 충돌 확인 / 생성 시각"
    TIMESTAMP created_at "수정 충돌 확인 / 생성 시각"
  }
  team_logos {
    BIGINT team_id PK, FK "teams.id · 팀당 최대 한 행"
    MEDIUMBLOB png_data "MEDIUMBLOB · 256×256 PNG"
    TIMESTAMP updated_at "TIMESTAMP(6) · 마지막 저장 시각"
  }
  players {
    BIGINT id PK "BIGINT · 등번호와 별개"
    BIGINT team_id FK "teams.id"
    VARCHAR name "이름 / 생년"
    INT birth_year "이름 / 생년"
    INT shirt_number "1~99 또는 NULL"
    VARCHAR first_choice "선호 포지션 순위"
    VARCHAR second_choice "선호 포지션 순위"
    VARCHAR third_choice "선호 포지션 순위"
    VARCHAR position "포지션 분류 / 명단 직책"
    VARCHAR club_role "포지션 분류 / 명단 직책"
    VARCHAR player_type "MEMBER·GUEST / 활동 여부"
    BIT active "MEMBER·GUEST / 활동 여부"
    DATE joined_on "가입일 / 수정 버전"
    BIGINT version "가입일 / 수정 버전"
    INT active_shirt_number "generated from active and shirt_number; composite UK with team_id"
  }
  tournaments {
    BIGINT id PK "BIGINT"
    BIGINT team_id FK "teams.id"
    VARCHAR name "대회명"
    DATE start_date "대회 기간"
    DATE end_date "대회 기간"
    VARCHAR venue "장소 / 참가 부문 / 메모"
    VARCHAR division "장소 / 참가 부문 / 메모"
    VARCHAR notes "장소 / 참가 부문 / 메모"
    BIGINT version "수정 충돌 확인"
  }
  match_records {
    BIGINT id PK "BIGINT"
    BIGINT team_id FK "teams.id"
    BIGINT tournament_id FK "tournaments.(team_id,id) · 대회 선택"
    DATE played_on "경기 날짜 / 시작 시각"
    TIME kickoff "경기 날짜 / 시작 시각"
    VARCHAR match_kind "EXTERNAL / INTERNAL"
    VARCHAR match_format "FOUR_QUARTERS / TWO_HALVES_30"
    VARCHAR formation_a "포메이션 · 자체전 A/B 독립"
    VARCHAR formation_b "포메이션 · 자체전 A/B 독립"
    INT score_for "우리:상대 또는 A:B"
    INT score_against "우리:상대 또는 A:B"
    VARCHAR tournament_stage "대회 단계 / 입력 진행 상태"
    VARCHAR recording_stage "대회 단계 / 입력 진행 상태"
    VARCHAR venue "장소 / 상대 / 메모 / 버전"
    VARCHAR opponent "장소 / 상대 / 메모 / 버전"
    VARCHAR notes "장소 / 상대 / 메모 / 버전"
    BIGINT version "장소 / 상대 / 메모 / 버전"
  }
  match_participants {
    BIGINT match_id PK, FK "match_records.id"
    BIGINT player_id PK, FK "players.id"
    VARCHAR vote "참석 예정 / 불참 / 미정 / 미투표"
    VARCHAR attendance "참석 / 지각 / 불참 / 미확인"
    VARCHAR planned_team "자체전 사전 A/B 배정 · NULL 가능"
  }
  match_quarters {
    BIGINT match_id PK, FK "match_records.id"
    INT quarter_number PK "1~4 · 전·후반은 1/2"
    BIT goal_events_linked "BOOLEAN · 기본 FALSE · 연결 기록 사용"
    INT goals_against "INT NULL · 외부 경기 구간 실점 · V32"
    TEXT scoring_order "TEXT NULL · JSON 배열 CHECK · V33"
  }
  match_planned_lineups {
    BIGINT match_id PK, FK "match_records.id"
    INT quarter_number PK "구간 번호 / A·B"
    VARCHAR team PK "구간 번호 / A·B"
    VARCHAR slot PK "자리 / 선발 0·교체 1"
    INT entry_order PK "자리 / 선발 0·교체 1"
    BIGINT player_id FK "players.id"
  }
  match_appearances {
    BIGINT match_id PK, FK "match_records.id"
    INT quarter_number PK "구간 번호 / A·B"
    VARCHAR team PK "구간 번호 / A·B"
    VARCHAR slot PK "자리 / 선발 0·교체 1"
    INT entry_order PK "자리 / 선발 0·교체 1"
    BIGINT player_id FK "players.id"
    INT goals "골 / 도움"
    INT assists "골 / 도움"
    INT free_kick_goals "총 골 안의 직접 FK / PK"
    INT penalty_goals "총 골 안의 직접 FK / PK"
  }
  match_goal_events {
    BIGINT match_id PK, FK "match_records.id · 경기 삭제 시 CASCADE"
    INT event_order PK "경기 전체 이벤트 목록 순서 · 0부터"
    INT quarter_number "구간 번호 / 득점 팀 A·B"
    VARCHAR team "구간 번호 / 득점 팀 A·B"
    BIGINT scorer_id FK "players.id · 득점 선수"
    BIGINT assist_id FK "players.id · 도움 선수 · NULL 가능"
    VARCHAR goal_type "NORMAL / FREE_KICK / PENALTY"
  }
  accounts {
    BIGINT id PK "BIGINT"
    VARCHAR username UK "로그인 ID"
    VARCHAR password_hash "해시만 저장"
    BIGINT credential_version "BIGINT · 이전 로그인 무효화"
    BIT enabled "계정 활성 / 서비스 관리자 여부"
    BIT service_admin "계정 활성 / 서비스 관리자 여부"
    VARCHAR role "기존 호환 역할 ADMIN / MEMBER"
  }
  account_password_resets {
    BIGINT id PK "BIGINT"
    BIGINT account_id FK "accounts.id · 재설정 대상"
    BIGINT issued_by FK "accounts.id · 발급한 서비스 관리자"
    CHAR token_hash UK "재설정 토큰 해시 · 원문 저장 안 함"
    BIGINT credential_version "발급 당시 계정 인증 버전"
    TIMESTAMP created_at "발급 시각 / 30분 유효기간"
    TIMESTAMP expires_at "발급 시각 / 30분 유효기간"
    TIMESTAMP used_at "사용 / 폐기 시각 · NULL 가능"
    TIMESTAMP revoked_at "사용 / 폐기 시각 · NULL 가능"
  }
  team_memberships {
    BIGINT id PK "BIGINT"
    BIGINT team_id FK "teams.id"
    BIGINT account_id FK "accounts.id · 삭제 시 CASCADE"
    VARCHAR role "DIRECTOR / COACH / MEMBER"
    BIT active "활성 여부 / 등록 시각"
    TIMESTAMP created_at "활성 여부 / 등록 시각"
  }
  team_invites {
    BIGINT id PK "BIGINT"
    BIGINT team_id FK "teams.id"
    BIGINT created_by FK "accounts.id"
    CHAR token_hash UK "초대 토큰의 해시"
    VARCHAR display_name "초대 이름 / DIRECTOR·COACH"
    VARCHAR role "초대 이름 / DIRECTOR·COACH"
    TIMESTAMP expires_at "만료 / 사용 / 취소 시각"
    TIMESTAMP used_at "만료 / 사용 / 취소 시각"
    TIMESTAMP cancelled_at "만료 / 사용 / 취소 시각"
    BIGINT version "수정 버전 / 생성 시각"
    TIMESTAMP created_at "수정 버전 / 생성 시각"
  }
  team_codes {
    BIGINT team_id PK, FK "teams.id · 팀당 최대 한 행"
    CHAR code_hash UK "접속 코드의 해시 · NULL 가능"
    VARCHAR password_hash "팀 비밀번호의 해시"
    BIGINT issued_by FK "accounts.id · NULL 가능"
    BIGINT version "교체·폐기 때 세션 유효성 검사"
    TIMESTAMP issued_at "발급 / 만료 / 폐기 시각"
    TIMESTAMP expires_at "발급 / 만료 / 폐기 시각"
    TIMESTAMP revoked_at "발급 / 만료 / 폐기 시각"
  }
  team_creation_requests {
    BIGINT account_id PK, FK "accounts.id"
    CHAR request_id PK "요청 UUID"
    CHAR request_hash "요청 내용의 해시"
    BIGINT team_id FK "teams.id · 결과 전에는 NULL"
    BIGINT invite_id FK "team_invites.id · NULL 가능"
    TIMESTAMP created_at "생성 시각"
  }
  team_code_events {
    BIGINT id PK "BIGINT"
    BIGINT team_id FK "teams.id"
    BIGINT actor_account_id FK "accounts.id"
    VARCHAR action "ISSUED / ROTATED / REVOKED"
    TIMESTAMP occurred_at "변경 시각 / 당시 만료 시각"
    TIMESTAMP expires_at "변경 시각 / 당시 만료 시각"
    BIGINT version "복합 UK 일부: team_id + version"
  }
  match_record_events {
    BIGINT id PK "BIGINT"
    BIGINT team_id FK "teams.id"
    BIGINT match_id "match_records.id · FK 없음"
    BIGINT actor_account_id "accounts.id · FK 없음"
    VARCHAR actor_username "당시 작업자 / 동작 / UTC 시각"
    VARCHAR action "당시 작업자 / 동작 / UTC 시각"
    DATETIME occurred_at "당시 작업자 / 동작 / UTC 시각"
    BIGINT before_version "변경 전후 버전"
    BIGINT after_version "변경 전후 버전"
    JSON before_snapshot "변경 전후 JSON"
    JSON after_snapshot "변경 전후 JSON"
    DATE played_on "당시 경기 요약"
    VARCHAR match_kind "당시 경기 요약"
    VARCHAR opponent "당시 경기 요약"
  }
  match_save_requests {
    BIGINT team_id PK "팀 / 작업자 · FK 없음"
    BIGINT actor_account_id PK "팀 / 작업자 · FK 없음"
    CHAR request_key PK "요청 UUID"
    VARCHAR request_method "POST / PUT"
    BIGINT target_match_id "수정 대상 / 저장 결과 · FK 없음"
    BIGINT match_id "수정 대상 / 저장 결과 · FK 없음"
    CHAR request_fingerprint "본문 대신 해시만 저장"
    BIGINT result_version "저장 결과 버전"
    DATETIME created_at "요청 / 완료 시각"
    DATETIME completed_at "요청 / 완료 시각"
  }
  flyway_schema_history {
    INT installed_rank PK "적용 순서"
    VARCHAR version "마이그레이션 버전과 파일"
    VARCHAR description "마이그레이션 버전과 파일"
    VARCHAR script "마이그레이션 버전과 파일"
    INT checksum "스크립트 지문 / 성공 여부"
    BOOLEAN success "스크립트 지문 / 성공 여부"
    VARCHAR installed_by "적용 주체 / 시각"
    TIMESTAMP installed_on "적용 주체 / 시각"
  }
